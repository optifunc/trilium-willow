{
  "name": "trilium-willow",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.1",
  "scripts": {
    "build": "pnpm --dir mr build && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "spike:deploy": "node scripts/deploy-spike.mjs",
    "spike:test": "node scripts/test-spike.mjs",
    "test:trilium": "node scripts/test-spike.mjs && node scripts/test-vertical-slice.mjs",
    "spike:test:desktop": "node scripts/test-desktop-spike.mjs"
  },
  "dependencies": { "@mindmap/widget": "workspace:*" },
  "devDependencies": {
    "@types/node": "24.10.1",
    "playwright": "1.58.2",
    "typescript": "5.9.3",
    "vite": "7.3.1",
    "vitest": "4.0.18"
  }
}
