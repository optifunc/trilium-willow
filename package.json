{
  "name": "trilium-willow",
  "version": "0.1.3",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.1",
  "scripts": {
    "build": "pnpm --dir mr build && vite build",
    "package": "pnpm build && python3 scripts/package-addon.py",
    "test:distribution": "node scripts/test-distribution.mjs",
    "test:packaging": "python3 -m unittest discover -s tests -p '*_test.py'",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "spike:deploy": "node scripts/deploy-spike.mjs",
    "spike:test": "node scripts/test-spike.mjs",
    "test:trilium": "node scripts/test-spike.mjs && node scripts/test-vertical-slice.mjs && node scripts/test-navigation.mjs && node scripts/test-selection-focus.mjs",
    "test:hardening": "node scripts/test-hardening.mjs && node scripts/test-host.mjs && node scripts/test-sync.mjs && node scripts/test-review-regressions.mjs",
    "test:desktop:lifecycle": "node scripts/test-desktop-lifecycle.mjs",
    "test:title": "node scripts/test-title-sync.mjs",
    "test:title:desktop": "node scripts/test-desktop-spike.mjs --title-sync",
    "test:zoom": "node scripts/test-zoom.mjs",
    "test:zoom:desktop": "node scripts/test-zoom.mjs --desktop",
    "dev:desktop": "node scripts/run-desktop.mjs",
    "spike:test:desktop": "node scripts/test-desktop-spike.mjs"
  },
  "dependencies": { "@mindmap/widget": "workspace:*" },
  "devDependencies": {
    "@types/node": "24.10.1",
    "playwright": "1.58.2",
    "typescript": "5.9.3",
    "vite": "7.3.1",
    "vitest": "4.0.18"
  }
}
